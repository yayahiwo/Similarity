<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/similarity_dialog_h_padding"
    android:paddingEnd="@dimen/similarity_dialog_h_padding"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/settingsShowTextSimilaritySliderSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show text-search similarity slider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="When enabled, a threshold slider appears above the grid for text searches."
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="CPU micro-batch size (indexing)"
        app:hintTextColor="@android:color/darker_gray"
        style="?attr/textInputOutlinedExposedDropdownMenuStyle">

        <AutoCompleteTextView
            android:id="@+id/settingsCpuMicroBatchDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:text="128" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/settingsCpuMicroBatchInfoTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Higher can be faster on CPU, but uses more memory."
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/settingsCpuResizeFilterSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Use resize filtering (slower)" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="When disabled, resizing is faster but may slightly reduce embedding quality."
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp" />

</LinearLayout>
