<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/searchFragment">
    <fragment
        android:id="@+id/indexFragment"
        android:name="com.yayahiwo.similarity.fragments.IndexFragment"
        android:label="fragment_index"
        tools:layout="@layout/fragment_index">
        <action
            android:id="@+id/action_indexFragment_to_searchFragment"
            app:destination="@id/searchFragment"
            app:popUpTo="@+id/indexFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.yayahiwo.similarity.fragments.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_searchFragment_to_imageFragment"
            app:destination="@id/imageFragment" />
        <action
            android:id="@+id/action_searchFragment_to_indexFragment"
            app:destination="@id/indexFragment"
            app:popUpTo="@id/searchFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/imageFragment"
        android:name="com.yayahiwo.similarity.fragments.ImageFragment"
        android:label="fragment_image"
        tools:layout="@layout/fragment_image">
        <action
            android:id="@+id/action_imageFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
    </fragment>
</navigation>
