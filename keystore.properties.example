# Copy to keystore.properties (this file is ignored by git).
# Use absolute paths or paths relative to the repo root.
storeFile=/absolute/path/to/similarity-release.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME

